# App
ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# JWT
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60

# Dev (SQLite default keeps tests simple)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Local Postgres (docker-compose)
# DATABASE_URL=postgresql+psycopg_async://postgres:postgres@postgres:5432/app

# Neon (prod)
# DATABASE_URL=postgresql+psycopg_async://<user>:<pass>@<neon-host>/<db>?sslmode=require

# Redis (dev)
REDIS_URL=redis://redis:6379/0

# Redis (prod – Upstash)
# REDIS_URL=rediss://:<password>@<upstash-host>:<port>
