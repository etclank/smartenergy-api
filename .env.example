# .env.example

# Runtime
ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# Database (dev: sqlite file for convenience; override in real envs/CI)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Redis (optional; leave blank to disable caching)
# e.g., redis://localhost:6379/0 or Upstash rediss://:PASSWORD@HOST:PORT
REDIS_URL=

# JWT
# ⚠️ change this in real environments
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60
