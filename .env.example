# Local SQLite development. Generate JWT_SECRET before starting the API.
ENV=dev
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./app.db
JWT_SECRET=
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60
REDIS_URL=
CACHE_TTL_SECONDS=60
FRONTEND_ORIGINS=[]
SEED_DEMO=0
# Required only when deliberately creating a fresh demo dataset.
DEMO_PASSWORD=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
HEALTH_EMAIL_TO=
# Logging and telemetry read process environment, not this dotenv file.
