# Copy to .env.vm in the repository root; do not commit the populated file.
SMARTENERGY_IMAGE=ghcr.io/OWNER/smartenergy-api@sha256:REPLACE_WITH_PUBLISHED_DIGEST
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DB_HOST:5432/smartenergy
JWT_SECRET=
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60
REDIS_URL=
# Redis is optional for the API, required for the worker profile.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
FRONTEND_ORIGINS=[]
LOG_LEVEL=INFO
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
HEALTH_EMAIL_TO=
